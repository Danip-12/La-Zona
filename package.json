{
  "name": "la-zona",
  "version": "1.0.0",
  "description": "LA ZONA — juego de adivinar para 2 a 8 jugadores en un solo dispositivo. PWA offline.",
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node scripts/serve.js",
    "test": "node --test tests/*.test.js",
    "serve": "node scripts/serve.js",
    "icons": "python3 scripts/make-icons.py",
    "build": "node scripts/bundle.js && node scripts/build.js",
    "test:e2e": "node tests/e2e/game.e2e.mjs",
    "test:all": "npm test && npm run test:e2e",
    "bundle": "node scripts/bundle.js"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
